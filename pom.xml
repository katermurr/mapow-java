<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>de.mapow.java</groupId>
  <artifactId>mapow-java-features</artifactId>
  <name>mapow-java-features</name>
  <version>0.0.1-SNAPSHOT</version>
  <description>demo of new java features for each version</description>

  <properties>
    <mapow-testing.version>0.0.2-SNAPSHOT</mapow-testing.version>
  </properties>

  <parent>
    <groupId>de.mapow</groupId>
    <artifactId>mapow-maven-bom</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <dependencies>
    <dependency>
      <groupId>de.mapow</groupId>
      <artifactId>mapow-testing</artifactId>
      <version>${mapow-testing.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>de/mapow/java17/sealeddemo/*.class</exclude>
            <exclude>de/mapow/java/threads/ThreadSleep.class</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>